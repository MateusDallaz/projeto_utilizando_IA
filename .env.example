# Copie este arquivo para ".env" e preencha com seus dados reais.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_aqui
DB_NAME=projeto_utilizando_ia

# Chave que assina o cookie de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Se ficar vazia, uma nova é gerada a cada início do servidor.
SECRET_KEY=

# true apenas durante o desenvolvimento
FLASK_DEBUG=false
